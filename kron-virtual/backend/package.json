{
  "name": "kron-virtual-backend",
  "version": "1.0.0",
  "description": "Express backend server running on Node.js with Drizzle ORM",
  "main": "src/index.ts",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate:sqlite",
    "db:push": "drizzle-kit push:sqlite",
    "db:generate:pg": "drizzle-kit generate:pg",
    "db:push:pg": "drizzle-kit push:pg"
  },
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.29.3",
    "express": "^4.18.3",
    "postgres": "^3.4.3",
    "tsx": "^4.7.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.24",
    "drizzle-kit": "^0.20.14",
    "typescript": "^5.3.3"
  },
  "allowScripts": {
    "better-sqlite3@13.2.0": true
  }
}
